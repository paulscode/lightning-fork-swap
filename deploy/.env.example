# Copy to .env (scripts/setup.sh does this and fills in the secrets).
LFSWAP_ROOT=/srv/lfswap
# mainnet, or regtest for a staging or rehearsal stack (the BLAKE2b fork from
# block 20, the temporary data rules in force, no TLS needed).
NETWORK=mainnet
PUBLIC_IP=91.190.100.60
DOMAIN=lightningfork.com

# Swap terms. Fees in percent; amounts in satoshis.
REVERSE_FEE_PERCENT=0.5
SUBMARINE_FEE_PERCENT=0.5
MIN_SWAP_SAT=10000
MAX_SWAP_SAT=1000000

# Generated by scripts/setup.sh; never commit them.
LND_RPCPASSWORD=
BOLTZ_RPCPASSWORD=
SHIM_RPCPASSWORD=
POSTGRES_PASSWORD=
TOR_CONTROL_PASSWORD=

# Offsite backups (scripts/backup-offsite.sh): the operator's age public key,
# whose private key is kept offline, and where to copy each backup.
BACKUP_AGE_RECIPIENT=
BACKUP_DEST=

# Alerts (monitor/lfswap_monitor.py, every five minutes from cron). Without a
# URL they are only written to $LFSWAP_ROOT/monitor/monitor.log. KIND is
# discord, slack (also Mattermost), telegram, ntfy or json. For telegram the
# URL is https://api.telegram.org/bot<token>/sendMessage and CHAT_ID the chat.
# Test with: python3 monitor/lfswap_monitor.py --test
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=json
ALERT_TELEGRAM_CHAT_ID=
# Alert when the on-chain wallet holds less than this (sat; empty: never),
# when lnd has fewer peers, or when the newest block is older (minutes).
MONITOR_MIN_WALLET_SAT=
MONITOR_MIN_PEERS=1
MONITOR_MAX_TIP_AGE_MIN=120
