# Copy to .env (scripts/setup.sh does this and fills in the secrets).
LFSWAP_ROOT=/srv/lfswap
# mainnet, or regtest for a staging or rehearsal stack (the BLAKE2b fork from
# block 20, the temporary data rules in force, no TLS needed).
NETWORK=mainnet
PUBLIC_IP=91.190.100.60
DOMAIN=lightningfork.com

# Swap terms. Fees in percent; amounts in satoshis.
REVERSE_FEE_PERCENT=0.5
SUBMARINE_FEE_PERCENT=0.5
MIN_SWAP_SAT=10000
MAX_SWAP_SAT=1000000

# Generated by scripts/setup.sh; never commit them.
LND_RPCPASSWORD=
BOLTZ_RPCPASSWORD=
SHIM_RPCPASSWORD=
POSTGRES_PASSWORD=
TOR_CONTROL_PASSWORD=

# Offsite backups (scripts/backup-offsite.sh): the operator's age public key,
# whose private key is kept offline, and where to copy each backup.
BACKUP_AGE_RECIPIENT=
BACKUP_DEST=
